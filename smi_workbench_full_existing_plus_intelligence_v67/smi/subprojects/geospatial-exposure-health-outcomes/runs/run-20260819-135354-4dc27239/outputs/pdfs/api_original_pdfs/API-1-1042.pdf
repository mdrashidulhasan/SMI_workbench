         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Is ambient heat exposure levels associated with miscarriage or stillbirths in hot regions? A cross-sectional study using survey data from the Ghana Maternal Health Survey 2007</rdf:li>
            </rdf:Alt>
         </dc:title>

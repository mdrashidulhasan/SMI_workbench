                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="ID of PDF/X standard"
                  pdfaProperty:name="GTS_PDFXVersion"
                  pdfaProperty:valueType="Text"/>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="Conformance level of PDF/X standard"
                  pdfaProperty:name="GTS_PDFXConformance"
                  pdfaProperty:valueType="Text"/>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="Company creating the PDF"
                  pdfaProperty:name="Company"
                  pdfaProperty:valueType="Text"/>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="Date when document was last modified"
                  pdfaProperty:name="SourceModified"
                  pdfaProperty:valueType="Text"/>
              </rdf:Seq>
            </pdfaSchema:property>
            </rdf:Description>
          </rdf:li>
          <rdf:li>
            <rdf:Description
